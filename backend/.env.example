# ===== Server =====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ===== PostgreSQL Database =====
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=elitecare_user
DB_PASSWORD=change_this_password
DB_NAME=elitecare_db

# ===== JWT Auth =====
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ===== Optional: Gemini AI (Symptom Checker / Medicine Scanner / Chatbot) =====
# Leave blank to run those 3 endpoints in mock mode.
GEMINI_API_KEY=

# ===== Reminders & notifications (Health Hub) =====
# Which transport reminder/notification jobs use by default.
#   console = log-only (default, local development)
#   inapp   = write to the `notifications` table (the in-app bell)
#   twilio  = SMS adapter skeleton — throws "not configured" unless configured
#   msg91   = SMS adapter skeleton — throws "not configured" unless configured
REMINDER_PROVIDER=console

# Background job runner (started from server.js, runs once a minute).
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
# Print one line per scheduler tick (local debugging only).
SCHEDULER_DEBUG=false
# Allow notification bodies (which contain health data) in local console output.
# Ignored when NODE_ENV=production. Keep false in any shared or deployed setup.
NOTIFY_LOG_BODY=false

# --- Twilio SMS (optional, placeholder — no SDK bundled in this build) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 SMS (optional, placeholder — no SDK bundled in this build) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ===== Rate limiting (Phase 0 hardening) =====
# Current production defaults: login 10/15min, AI 30/15min.
# For local development, use generous values to avoid 429s during repeated test runs.
RATE_LIMIT_LOGIN_MAX=100
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_AI_MAX=200
RATE_LIMIT_AI_WINDOW_MIN=15

# ===== Phase 5 — Safety and trust =====
# The origin the Emergency Health Card QR code points at. In development the
# card page is served by Vite, so this is the Vite origin.
PUBLIC_APP_URL=http://localhost:5173
# When true, only doctors with status='approved' in doctor_verifications may be
# listed and booked. Off by default so a fresh install is not locked out; the
# demo doctors are seeded as approved by migration 006.
REQUIRE_DOCTOR_VERIFICATION=false
# Doctor-patient access window: how many days back an appointment/record/prescription
# counts as an "active relationship". Default 90 days.
DOCTOR_ACCESS_WINDOW_DAYS=90

# ===== Phase 4 — Rewards =====
# Coins awarded to BOTH sides of a successful referral.
REFERRAL_REWARD_COINS=100
